<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="GameHub.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - LAN Game Hub</title>
    <meta name="description" content="Offline LAN Game Hub featuring Tic-Tac-Toe, Connect 4, and Rock-Paper-Scissors with AI bots and real-time multiplayer." />
    
    <!-- Self-Hosted Vanilla CSS (Zero External / CDN Dependencies) -->
    <link href="~/Content/site.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/games.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/animations.css" rel="stylesheet" type="text/css" />

    <!-- Self-Hosted JavaScript (Zero CDN Dependencies) -->
    <script type="text/javascript">
        window.APP_ROOT = '<%= ResolveUrl("~/") %>';
    </script>
    <script src="<%= ResolveUrl("~/Scripts/jquery-3.7.1.min.js") %>" type="text/javascript"></script>
    <script src="<%= ResolveUrl("~/Scripts/jquery.signalR-2.4.3.min.js") %>" type="text/javascript"></script>
    <script src="<%= ResolveUrl("~/signalr/hubs") %>" type="text/javascript"></script>
    <script src="<%= ResolveUrl("~/Scripts/audio.js?v=2.2") %>" type="text/javascript"></script>
    <script src="<%= ResolveUrl("~/Scripts/app.js?v=2.2") %>" type="text/javascript"></script>
    <script src="<%= ResolveUrl("~/Scripts/hub-client.js?v=2.2") %>" type="text/javascript"></script>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="mainForm" runat="server">
        <header class="app-header">
            <div class="app-container header-inner">
                <a href="<%= ResolveUrl("~/Default.aspx") %>" class="brand-link" id="brand-home-link">
                    <svg xmlns="http://www.w3.org/2000/svg" class="brand-logo-svg" viewBox="0 0 40 40" fill="none">
                        <rect width="40" height="40" rx="10" fill="url(#brandGrad)"/>
                        <path d="M12 20h16M20 12v16" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round"/>
                        <circle cx="28" cy="14" r="2.5" fill="#38bdf8"/>
                        <circle cx="12" cy="26" r="2.5" fill="#fb7185"/>
                        <defs>
                            <linearGradient id="brandGrad" x1="0" y1="0" x2="40" y2="40" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#0284c7"/>
                                <stop offset="0.5" stop-color="#6366f1"/>
                                <stop offset="1" stop-color="#a855f7"/>
                            </linearGradient>
                        </defs>
                    </svg>
                    <span class="brand-title">GAME HUB</span>
                </a>

                <div class="header-actions">
                    <div class="online-counter-badge" id="online-badge-wrapper" title="Players connected to this intranet server">
                        <span class="online-dot"></span>
                        <span><strong id="online-players-count">1</strong> Online</span>
                    </div>

                    <button type="button" class="icon-btn" id="sound-toggle-btn" title="Toggle Sound">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                            <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>
                        </svg>
                    </button>

                    <div class="profile-pill" id="profile-pill-btn" title="Click to change your display name">
                        <div class="profile-avatar" id="header-avatar-letter">P</div>
                        <span class="profile-name" id="header-profile-name">Player</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="profile-edit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                        </svg>
                    </div>
                </div>
            </div>
        </header>

        <main class="main-content app-container">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <footer class="app-footer">
            <div class="app-container footer-inner">
                <div>
                    <strong>Game Hub</strong> - Offline LAN Gaming Platform (.NET 4.5 / SignalR 2.x)
                </div>
                <div class="footer-lan-info">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2">
                        <rect x="2" y="2" width="20" height="8" rx="2" ry="2"/>
                        <rect x="2" y="14" width="20" height="8" rx="2" ry="2"/>
                        <line x1="6" y1="6" x2="6.01" y2="6"/>
                        <line x1="6" y1="18" x2="6.01" y2="18"/>
                    </svg>
                    <span>Zero External CDN | 100% Offline Hostable</span>
                </div>
            </div>
        </footer>
    </form>
</body>
</html>
